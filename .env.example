# Copy to .env at the repo root. Never commit .env.
# Empty values stay "not connected". DropShop does not invent results for them.

# --- General ---
MOCK_MODE=true
DEMO_USER_ID=demo-user
SESSION_SECRET=
TOKEN_ENCRYPTION_KEY=
# Generate a Fernet key with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# --- API ---
API_BASE_URL=http://localhost:8000
PUBLIC_BASE_URL=http://localhost:8000
REDIS_URL=redis://localhost:6379
CORS_ORIGINS=http://localhost:3000

# --- Gemini (live only after a successful call) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# --- Gmail readonly OAuth ---
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:8000/integrations/gmail/callback

# --- Sentient OS ---
# Reading stays off until the user opts in. Default folder:
#   ~/Sentient OS - Knowledge Base
SENTIENT_OS_ENABLED=false
SENTIENT_KNOWLEDGE_DIR=

# --- Playwright ---
PLAYWRIGHT_HEADLESS=true

# --- MongoDB ---
# Atlas example: mongodb+srv://USER:PASSWORD@cluster.mongodb.net/
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=dropshot

# --- Tiger Data / TimescaleDB ---
# Local docker: postgresql://postgres:password@localhost:5432/dropshot
# Tiger Cloud: use the service URL they give you. A localhost URL is not Tiger Cloud.
TIMESCALE_URL=postgresql://postgres:password@localhost:5432/dropshot

# --- Capital One Nessie sandbox ---
NESSIE_API_KEY=
NESSIE_BASE_URL=https://api.nessieisreal.com
NESSIE_ACCOUNT_ID=
NESSIE_CUSTOMER_ID=

# --- Solana Devnet only ---
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_VAULT_ADDRESS=
# No program is deployed. Leave this empty.
SOLANA_PROGRAM_ID=
# Do not put a seed phrase or private key in the app.
SOLANA_KEYPAIR_PATH=

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
