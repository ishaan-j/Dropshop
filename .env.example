# Copy to .env and fill in. Never commit .env.

# --- General ---
MOCK_MODE=false                         # true = API returns mock data; flip off per integration as it lands
DEMO_USER_ID=demo-user                 # single hardcoded user for the hackathon (no auth)

# --- Layer 2: Backend ---
API_BASE_URL=http://localhost:8000
REDIS_URL=redis://localhost:6379
CORS_ORIGINS=http://localhost:3000

# --- Layer 3: AI / Agents ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash          # check the newest available model at the event
XAI_API_KEY=                            # Grok Bot policy watch
XAI_MODEL=grok-4
GEMINI_TIMEOUT_SECONDS=20
SENTIENT_OS_ENABLED=false
SENTIENT_KNOWLEDGE_DIR=~/sentient-os/knowledge   # where Sentient OS writes its Markdown (unconfirmed)
PLAYWRIGHT_HEADLESS=true
RETAILER_CLAIM_URL=http://localhost:3000/demo-store/claim

# --- Layer 4: Database ---
MONGODB_URI=mongodb://localhost:27017  # Atlas: mongodb+srv://<user>:<pass>@<cluster>/...
MONGODB_DB=dropshot
TIMESCALE_URL=postgresql://postgres:password@localhost:5432/dropshot   # Tiger Cloud: use the service URL

# --- Layer 5: Financial ---
NESSIE_API_KEY=
NESSIE_BASE_URL=http://api.nessieisreal.com
NESSIE_ACCOUNT_ID=                     # demo user's checking account id (create via seed script)
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_PROGRAM_ID=
SOLANA_KEYPAIR_PATH=./solana/dev-keypair.json   # gitignored

# --- Layer 1: Frontend (Next.js reads NEXT_PUBLIC_*) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
