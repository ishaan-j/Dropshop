# Copy to .env and fill in. Never commit .env.

# --- General ---
MOCK_MODE=true                          # true = demo data, no external calls. false = live Gemini/xAI/Nessie/Solana where implemented
DEMO_USER_ID=demo-user                 # single hardcoded user for the hackathon (no auth)

# --- Layer 2: Backend ---
API_BASE_URL=http://localhost:8000     # public URL of the API (used for claim-bot screenshot links)
REDIS_URL=redis://localhost:6379       # only needed with DATA_BACKEND=db; otherwise jobs run inside the API
CORS_ORIGINS=http://localhost:3000
DATA_BACKEND=auto                      # auto | memory | db. auto = in-memory while MOCK_MODE=true, otherwise MongoDB
DEMO_MODE=true                         # fast job schedules, /demo endpoints, demo store refunds a submitted claim
DEMO_REFUND_DELAY_SECONDS=6            # how long after submission the demo refund lands (negative = never)

# --- Layer 3: AI / Agents ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite     # fast (about 1 s). The full flash models were overloaded at the event
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite   # tried in order when a model errors or is slow; the chain is tried twice
GEMINI_ATTEMPT_TIMEOUT_SECONDS=4       # per attempt
XAI_API_KEY=                            # Grok Bot policy watch
XAI_MODEL=grok-4.7                      # fast (about 2 s); the grok-4 alias was much slower
GEMINI_TIMEOUT_SECONDS=20              # whole call, then the offline fallback is used
SENTIENT_OS_ENABLED=false
SENTIENT_KNOWLEDGE_DIR="~/Sentient OS - Knowledge Base"   # Sentient OS's Markdown notes (Mac only)
AUTOMATION_TOKEN=                       # secret for POST /automations/* (used by the Grok Bot routine). Empty = off
PLAYWRIGHT_HEADLESS=true
RETAILER_CLAIM_URL=http://localhost:3000/demo-store/claim

# --- Layer 4: Database ---
MONGODB_URI=mongodb://localhost:27017  # Atlas: mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/ then `python -m data.seed`
MONGODB_DB=dropshot
TIMESCALE_URL=postgresql://postgres:password@localhost:5432/dropshot   # Tiger Cloud: the service URL (postgres://tsdbadmin:<pass>@<host>:<port>/tsdb?sslmode=require), then `python -m data.seed`

# --- Layer 5: Financial ---
NESSIE_API_KEY=
NESSIE_BASE_URL=https://api.nessieisreal.com
NESSIE_ACCOUNT_ID=                     # demo account id: finance.nessie.create_demo_customer_and_account()
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_PROGRAM_ID=                     # empty = ledger mode (no custom program). Set after deploying solana/savings_vault
SOLANA_KEYPAIR_PATH=./solana/dev-keypair.json   # gitignored. Create + fund: python -m finance.solana_setup (from backend/)

# --- Layer 1: Frontend (Next.js reads NEXT_PUBLIC_* from frontend/.env.local, not from this file) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_DATA_MODE=auto             # auto = use the backend when it's running, else in-browser demo data. api | demo force one

# --- Layer 6: Deployment (only used by infra/docker-compose.prod.yml) ---
PUBLIC_API_URL=http://localhost:8000   # how browsers reach the API, e.g. http://<server-ip>:8000
PUBLIC_WEB_URL=http://localhost:3000   # how browsers reach the frontend; becomes the allowed CORS origin
